{
  "name": "@docedit/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Oakqueill PDF Editor: read, organize, review and sign PDF documents on your own computer.",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dist": "node scripts/build.mjs && electron-builder --win --x64"
  },
  "devDependencies": {
    "@docedit/core": "0.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "node-forge": "^1.4.3",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "productName": "Oakqueill PDF Editor",
  "author": "Oakqueill contributors",
  "build": {
    "appId": "app.docedit.desktop",
    "productName": "Oakqueill PDF Editor",
    "copyright": "Copyright \u00a9 2026 Oakqueill contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "electronVersion": "45.3.1",
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF document",
        "description": "PDF document",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Oakqueill-Setup-${version}.${ext}",
      "license": "../../LICENSE",
      "shortcutName": "Oakqueill PDF Editor",
      "uninstallDisplayName": "Oakqueill PDF Editor"
    },
    "portable": {
      "artifactName": "Oakqueill-Portable-${version}.${ext}"
    },
    "executableName": "Oakqueill",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  }
}
