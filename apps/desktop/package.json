{
  "name": "@docedit/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Oakqueill PDF Editor: read, organize, review and sign PDF documents on your own computer.",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dist:mac": "node scripts/build.mjs && electron-builder --mac --universal -c.mac.identity=-"
  },
  "devDependencies": {
    "@docedit/core": "0.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "node-forge": "^1.4.3",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "productName": "Oakqueill PDF Editor",
  "author": "Oakqueill contributors",
  "build": {
    "appId": "app.docedit.desktop",
    "productName": "Oakqueill PDF Editor",
    "copyright": "Copyright \u00a9 2026 Oakqueill contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "electronVersion": "45.3.1",
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF document",
        "description": "PDF document",
        "role": "Editor"
      }
    ],
    "executableName": "Oakqueill",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "Oakqueill opens and saves the PDF files you choose."
      },
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "artifactName": "Oakqueill-${version}-mac-${arch}.${ext}",
      "title": "Oakqueill PDF Editor"
    }
  }
}
