{
  "name": "@docedit/browser",
  "version": "0.1.0",
  "private": true,
  "description": "Oakqueill PDF Viewer: a browser extension for Chrome, Edge, Brave, Opera, Vivaldi, Arc (Chromium), Firefox and Safari that opens PDFs in an Oakqueill viewer.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:all": "node scripts/build.mjs --target all",
    "build:firefox": "node scripts/build.mjs --target firefox",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dist": "node scripts/build.mjs --target all --zip",
    "lint:firefox": "web-ext lint --source-dir dist-firefox",
    "safari": "node scripts/safari.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "^6.5.438",
    "puppeteer-core": "^24.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-ext": "^8.0.0"
  }
}
